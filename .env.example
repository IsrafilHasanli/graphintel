# GraphIntel environment configuration
# Copy to .env and adjust. All values have safe local defaults.

# --- Core ---
GRAPHINTEL_ENV=local
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# --- PostgreSQL (relational + pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphintel
POSTGRES_USER=graphintel
POSTGRES_PASSWORD=change_me_for_shared_environments
# If set, overrides the components above.
# DATABASE_URL=postgresql+psycopg://graphintel:graphintel@localhost:5432/graphintel

# For fully offline/local dev & tests, use SQLite (graph falls back to in-memory/SQL):
# DATABASE_URL=sqlite:///./graphintel.sqlite3

# --- Graph backend ---
# Local/test default uses the SQL-backed graph mirror. AWS staging/prod must use Neptune.
GRAPH_BACKEND=sql

# AWS staging/prod graph backend.
# GRAPH_BACKEND=neptune
NEPTUNE_ENDPOINT=
NEPTUNE_PORT=8182
NEPTUNE_USE_IAM_AUTH=true

# --- Vector / Embeddings ---
# 'deterministic' = offline hashing embeddings (reproducible, no network).
# AWS staging/prod must use a real provider: 'fastembed', 'voyage', or 'bedrock'.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIM=256
FASTEMBED_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_EMBEDDING_MODEL=voyage-3-large
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
AWS_REGION=us-east-1

# --- LLM (optional) ---
# 'deterministic' = rule-based extraction & templated answers (offline, testable).
# 'anthropic' = use the Claude API (requires ANTHROPIC_API_KEY).
LLM_PROVIDER=deterministic
EXTRACTION_PROVIDER=deterministic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-opus-4-8

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=8
GRAPH_MAX_HOPS=3
MIN_ANSWER_CONFIDENCE=0.35
