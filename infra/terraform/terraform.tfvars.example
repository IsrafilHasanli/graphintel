# Copy to terraform.tfvars and adjust. None of these require secrets in the
# file itself -- the DB password is generated and the Anthropic key is optional.

aws_region  = "us-east-1"
environment = "staging"
project     = "graphintel"

# Sizing (defaults are cost-conscious; bump for prod).
api_desired_count = 2
api_cpu           = 512
api_memory        = 1024
db_instance_class = "db.t4g.micro"
redis_node_type   = "cache.t4g.micro"
neptune_instance_class = "db.t4g.medium"

# AWS staging/prod uses real providers, not mocks.
llm_provider        = "anthropic"
extraction_provider = "llm"
embedding_provider  = "fastembed"
fastembed_embedding_model = "BAAI/bge-small-en-v1.5"
bedrock_embedding_model = "amazon.titan-embed-text-v2:0"

# To enable the Claude-backed answer/extraction path, set the key here (or,
# better, export TF_VAR_anthropic_api_key so it never lands in a file):
# anthropic_api_key = "sk-ant-..."

# If you prefer Voyage or Bedrock embeddings:
# embedding_provider = "voyage"
# export TF_VAR_voyage_api_key="..."
# embedding_provider = "bedrock"

# api_image_tag is normally set by CI to the commit SHA:
# api_image_tag = "abc1234"
